<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LocalNugetRepo" value="G:\LocalNugetRepo" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="LocalNugetRepo">
      <package pattern="Avig.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />

      <!-- Avig-paketen ligger publikt på nuget.org. Mönstret står med på båda källorna
           med flit: publicerade versioner hämtas härifrån, medan en version som packats
           lokalt men ännu inte släppts fortfarande går att prova mot det lokala flödet.
           Att peka enbart hit hade brutit den rökprovningen. -->
      <package pattern="Avig.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
